# Credentials for the whole stack. Nothing in the repo holds a real value:
# run `make secrets` to generate a .env (gitignored), or copy this file to
# .env and fill it in by hand.
#
# `make secrets` also renders server/config from these values, which is what
# the server reads when you run ./matCha outside Docker.

# PostgreSQL role, password and database. The db container is created with
# these on its first start, so changing them later needs `make fclean` (which
# drops the volume) or an ALTER ROLE by hand.
DB_USER=matcha
DB_PASSWORD=
DB_NAME=matcha_db

# HMAC key the server signs session tokens with. Changing it invalidates
# every session that is currently logged in.
TOKEN_SECRET=
